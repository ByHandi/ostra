.env
*.db
*.db-*

# Dashboard build output (dist/web, embedded into the Go binary). dist/.gitkeep MUST be committed:
# without it go:embed fails on a fresh clone (e.g. in CI).
control/internal/ui/dist/*
!control/internal/ui/dist/.gitkeep
backups/
node_modules/

# Worktrees that Claude Code creates for isolated agent runs
.claude/worktrees/
