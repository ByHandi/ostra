# Production: certificates from Let's Encrypt.
# Env (set by docker-compose.yml from BASE_DOMAIN): ACME_EMAIL, CONSOLE_DOMAIN, S3_DOMAIN.
# Note: wildcard *.s3.<domain> (virtual-hosted style) needs a DNS challenge, which means Caddy
# has to be built with a DNS provider plugin. Here the S3 API is path-style only.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://control:9000/caddy/ask
	}
}

# S3 API
{$S3_DOMAIN} {
	reverse_proxy garage:3900
}

# Dashboard + /api
{$CONSOLE_DOMAIN} {
	reverse_proxy control:8080
}

# All other domains: per-bucket custom domains and <bucket>.web.<domain>.
# Certificates are issued on demand, only if the control-plane allows it via /caddy/ask.
https:// {
	tls {
		on_demand
	}
	reverse_proxy garage:3902
}
