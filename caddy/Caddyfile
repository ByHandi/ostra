# Production: sertifikat dari Let's Encrypt.
# Env (diisi docker-compose.yml dari BASE_DOMAIN): ACME_EMAIL, CONSOLE_DOMAIN, S3_DOMAIN.
# Catatan: wildcard *.s3.<domain> (virtual-hosted style) butuh DNS challenge, artinya Caddy
# di-build dengan plugin DNS provider. Di sini S3 API hanya path-style.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://control:9000/caddy/ask
	}
}

# S3 API
{$S3_DOMAIN} {
	reverse_proxy garage:3900
}

# Dashboard + /api
{$CONSOLE_DOMAIN} {
	reverse_proxy control:8080
}

# Semua domain lain: custom domain per bucket dan <bucket>.web.<domain>.
# Sertifikat dibuat on-demand, hanya kalau control-plane mengizinkan lewat /caddy/ask.
https:// {
	tls {
		on_demand
	}
	reverse_proxy garage:3902
}
