# Development: semua sertifikat diterbitkan CA lokal Caddy (bukan Let's Encrypt).
# Env sama dengan Caddyfile production (CONSOLE_DOMAIN, S3_DOMAIN), dengan BASE_DOMAIN=localhost.
{
	local_certs
	on_demand_tls {
		ask http://control:9000/caddy/ask
	}
}

# S3 API (path-style dan virtual-hosted style)
{$S3_DOMAIN}, *.{$S3_DOMAIN} {
	reverse_proxy garage:3900
}

# Dashboard + /api
{$CONSOLE_DOMAIN} {
	reverse_proxy control:8080
}

# Semua domain lain: custom domain per bucket dan <bucket>.web.localhost.
https:// {
	tls {
		on_demand
	}
	reverse_proxy garage:3902
}
