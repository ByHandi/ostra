# Development: all certificates are issued by Caddy's local CA (not Let's Encrypt).
# Same env as the production Caddyfile (CONSOLE_DOMAIN, S3_DOMAIN), with BASE_DOMAIN=localhost.
{
	local_certs
	on_demand_tls {
		ask http://control:9000/caddy/ask
	}
}

# S3 API (path-style and virtual-hosted style)
{$S3_DOMAIN}, *.{$S3_DOMAIN} {
	reverse_proxy garage:3900
}

# Dashboard + /api
{$CONSOLE_DOMAIN} {
	reverse_proxy control:8080
}

# All other domains: per-bucket custom domains and <bucket>.web.localhost.
https:// {
	tls {
		on_demand
	}
	reverse_proxy garage:3902
}
