# Jalankan scripts/gen-env.sh: membuat .env dan mengisi secret yang masih kosong.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
# Kunci tanda tangan access token dashboard
CONTROL_JWT_SECRET=
# false hanya untuk development lewat http:// (Vite dev server). WAJIB true di production.
COOKIE_SECURE=false

# Caddyfile.dev untuk lokal, Caddyfile untuk production
CADDYFILE=Caddyfile.dev

# Target CNAME yang harus dipasang user untuk custom domain
EDGE_HOSTNAME=edge.localhost
# Harus sama dengan s3_web.root_domain di garage/garage.toml
WEB_ROOT_DOMAIN=.web.localhost
# Domain milik sistem yang tidak boleh didaftarkan user (dipisah koma, termasuk subdomainnya)
RESERVED_DOMAINS=s3.localhost,console.localhost
# off = custom domain langsung aktif tanpa cek DNS. WAJIB "on" di production.
DNS_VERIFY=off
# Opsional, mis. 1.1.1.1:53. Kosong = resolver sistem.
DNS_SERVER=

# Hanya dipakai Caddyfile production
ACME_EMAIL=
S3_DOMAIN=
CONSOLE_DOMAIN=

# Akun admin dashboard untuk development, dibuat oleh scripts/init-dev.sh
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=

# Diisi otomatis oleh scripts/init-dev.sh
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
