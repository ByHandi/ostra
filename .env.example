# Konfigurasi production. Jalankan `scripts/gen-env.sh` untuk membuat .env dan mengisi
# secret otomatis, lalu isi BASE_DOMAIN dan ACME_EMAIL.
# Untuk development lokal pakai `scripts/gen-env.sh --dev` (semua terisi otomatis).

# Domain utama. Dari sini diturunkan:
#   console.<BASE_DOMAIN>   dashboard
#   s3.<BASE_DOMAIN>        S3 API
#   edge.<BASE_DOMAIN>      target CNAME untuk custom domain
#   *.web.<BASE_DOMAIN>     akses web per bucket
BASE_DOMAIN=
# Email untuk Let's Encrypt
ACME_EMAIL=

# Secret (diisi gen-env.sh)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
CONTROL_JWT_SECRET=

# Opsional: pin versi image control-plane (default ghcr.io/byhandi/storage-edge:latest)
# CONTROL_IMAGE=ghcr.io/byhandi/storage-edge:0.1.0

# Opsional: ganti nilai turunan dari BASE_DOMAIN
# EDGE_HOSTNAME=edge.domainku.com
# RESERVED_DOMAINS=s3.domainku.com,console.domainku.com
# Opsional: proxy di depan Caddy (mis. load balancer), daftar CIDR dipisah koma
# TRUSTED_PROXIES=
# Opsional: resolver untuk verifikasi DNS custom domain (default 1.1.1.1:53)
# DNS_SERVER=
