# Production configuration. Run `scripts/gen-env.sh` to create .env and fill in the
# secrets automatically, then set BASE_DOMAIN and ACME_EMAIL.
# For local development use `scripts/gen-env.sh --dev` (everything is filled in automatically).

# Main domain. The following are derived from it:
#   console.<BASE_DOMAIN>   dashboard
#   s3.<BASE_DOMAIN>        S3 API
#   edge.<BASE_DOMAIN>      CNAME target for custom domains
#   *.web.<BASE_DOMAIN>     per-bucket web access
BASE_DOMAIN=
# Email for Let's Encrypt
ACME_EMAIL=

# Secrets (filled in by gen-env.sh)
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
CONTROL_JWT_SECRET=

# Optional: pin the control-plane image version (default ghcr.io/byhandi/storage-edge:latest)
# CONTROL_IMAGE=ghcr.io/byhandi/storage-edge:0.1.0

# Optional: override values derived from BASE_DOMAIN
# EDGE_HOSTNAME=edge.example.com
# RESERVED_DOMAINS=s3.example.com,console.example.com
# Optional: proxies in front of Caddy (e.g. a load balancer), comma-separated list of CIDRs
# TRUSTED_PROXIES=
# Optional: resolver for custom domain DNS verification (default 1.1.1.1:53)
# DNS_SERVER=
